# Copy to .env and fill in real values. .env is gitignored — never commit it.
#   cp .env.example .env

# ---- app ----
ENVIRONMENT=local          # local | test | staging | production
DEBUG=true                 # must be false when ENVIRONMENT=production
PROJECT_NAME=E-Commerce API
API_V1_PREFIX=/api/v1

# ---- secrets (required: the app will not start without these) ----
# Generate a real one:  openssl rand -hex 32
SECRET_KEY=replace-me-with-32-plus-random-chars-abcdef

# Async driver for the app. Host is `db` under docker-compose, `localhost` otherwise.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ecommerce
REDIS_URL=redis://localhost:6379/0

# ---- auth ----
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
JWT_ALGORITHM=HS256

# ---- cors ----
CORS_ORIGINS=["http://localhost:3000"]
